{
  "workflowId": "facturation",
  "name": "Workflow Facturation",
  "version": "1.0.0",
  "initialStep": "Saisie de la demande",
  "finalSteps": ["Clôturée"],
  "steps": [
    {
      "id": "saisie_demande",
      "name": "Saisie de la demande",
      "type": "start",
      "main": true,
      "roles": ["utilisateur"],
      "autoValidated": true
    },
    {
      "id": "verification_metier",
      "name": "Vérification métier",
      "type": "task",
      "main": true,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "validation_n1",
      "name": "Validation métier N+1",
      "type": "task",
      "main": true,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "info_validation_n1",
      "name": "Demande d'information complémentaire (Validation métier N+1)",
      "type": "conditional",
      "main": false,
      "roles": ["manageur", "administrateur"],
      "returnsTo": "Validation métier N+1"
    },
    {
      "id": "traitement_appro",
      "name": "Traitement service approvisionnement",
      "type": "task",
      "main": true,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "info_appro",
      "name": "Demande d'information complémentaire (Traitement service approvisionnement)",
      "type": "conditional",
      "main": false,
      "roles": ["manageur", "administrateur"],
      "returnsTo": "Traitement service approvisionnement"
    },
    {
      "id": "signature_lad_1",
      "name": "Signature LAD 1",
      "type": "task",
      "main": true,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "info_signature_lad_1",
      "name": "Demande d'information complémentaire (Signature LAD 1)",
      "type": "conditional",
      "main": false,
      "roles": ["manageur", "administrateur"],
      "returnsTo": "Signature LAD 1"
    },
    {
      "id": "signature_lad_2",
      "name": "Signature LAD 2",
      "type": "optional",
      "main": false,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "signature_lad_3",
      "name": "Signature LAD 3",
      "type": "optional",
      "main": false,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "reglement",
      "name": "Règlement en cours",
      "type": "task",
      "main": true,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "paiement_effectue",
      "name": "Paiement effectué",
      "type": "event",
      "main": true,
      "roles": ["manageur", "administrateur"],
      "autoClosesTo": "Clôturée"
    },
    {
      "id": "rejetee",
      "name": "Rejetée",
      "type": "optional",
      "main": false,
      "roles": ["manageur", "administrateur"]
    },
    {
      "id": "cloturee",
      "name": "Clôturée",
      "type": "end",
      "main": true,
      "roles": ["systeme", "manageur", "administrateur"]
    }
  ],
  "transitions": [
    {
      "from": "Saisie de la demande",
      "to": "Vérification métier",
      "condition": "creation_demande",
      "label": "Validation automatique a la creation",
      "automatic": true
    },
    {
      "from": "Vérification métier",
      "to": "Validation métier N+1",
      "condition": "verification_validee",
      "label": "Valider la verification metier"
    },
    {
      "from": "Validation métier N+1",
      "to": "Traitement service approvisionnement",
      "condition": "validation_n1_ok",
      "label": "Valider N+1 (OK)"
    },
    {
      "from": "Validation métier N+1",
      "to": "Demande d'information complémentaire (Validation métier N+1)",
      "condition": "informations_complementaires_requises",
      "label": "Demander des informations complementaires"
    },
    {
      "from": "Demande d'information complémentaire (Validation métier N+1)",
      "to": "Validation métier N+1",
      "condition": "informations_recues",
      "label": "Retour a Validation metier N+1"
    },
    {
      "from": "Traitement service approvisionnement",
      "to": "Signature LAD 1",
      "condition": "traitement_appro_valide",
      "label": "Traitement valide (OK)"
    },
    {
      "from": "Traitement service approvisionnement",
      "to": "Demande d'information complémentaire (Traitement service approvisionnement)",
      "condition": "informations_complementaires_requises",
      "label": "Demander des informations complementaires"
    },
    {
      "from": "Demande d'information complémentaire (Traitement service approvisionnement)",
      "to": "Traitement service approvisionnement",
      "condition": "informations_recues",
      "label": "Retour a Traitement service approvisionnement"
    },
    {
      "from": "Signature LAD 1",
      "to": "Règlement en cours",
      "condition": "signature_lad_1_suffisante",
      "label": "Passer au reglement"
    },
    {
      "from": "Signature LAD 1",
      "to": "Signature LAD 2",
      "condition": "signature_lad_2_requise",
      "label": "Passer a signature LAD 2"
    },
    {
      "from": "Signature LAD 1",
      "to": "Signature LAD 3",
      "condition": "signature_lad_3_requise",
      "label": "Passer a signature LAD 3"
    },
    {
      "from": "Signature LAD 1",
      "to": "Demande d'information complémentaire (Signature LAD 1)",
      "condition": "informations_complementaires_requises",
      "label": "Demander des informations complementaires"
    },
    {
      "from": "Demande d'information complémentaire (Signature LAD 1)",
      "to": "Signature LAD 1",
      "condition": "informations_recues",
      "label": "Retour a Signature LAD 1"
    },
    {
      "from": "Signature LAD 2",
      "to": "Règlement en cours",
      "condition": "signature_lad_2_validee",
      "label": "Valider la signature LAD 2"
    },
    {
      "from": "Signature LAD 3",
      "to": "Règlement en cours",
      "condition": "signature_lad_3_validee",
      "label": "Valider la signature LAD 3"
    },
    {
      "from": "Règlement en cours",
      "to": "Paiement effectué",
      "condition": "paiement_confirme",
      "label": "Confirmer le paiement (OK)"
    },
    {
      "from": "Règlement en cours",
      "to": "Rejetée",
      "condition": "demande_rejetee",
      "label": "Rejeter la demande"
    },
    {
      "from": "Paiement effectué",
      "to": "Clôturée",
      "condition": "cloture_automatique_apres_paiement",
      "label": "Cloture automatique",
      "automatic": true
    },
    {
      "from": "Rejetée",
      "to": "Clôturée",
      "condition": "cloture_apres_rejet",
      "label": "Cloturer apres rejet"
    }
  ],
  "timeline": {
    "mainSteps": [
      "Saisie de la demande",
      "Vérification métier",
      "Validation métier N+1",
      "Traitement service approvisionnement",
      "Signature LAD 1",
      "Règlement en cours",
      "Paiement effectué",
      "Clôturée"
    ],
    "conditionalSteps": [
      "Demande d'information complémentaire (Validation métier N+1)",
      "Demande d'information complémentaire (Traitement service approvisionnement)",
      "Demande d'information complémentaire (Signature LAD 1)",
      "Signature LAD 2",
      "Signature LAD 3",
      "Rejetée"
    ],
    "displayRule": "Les etapes conditionnelles s'affichent uniquement si elles sont reellement empruntees."
  },
  "notes": [
    "Le backend cree directement une demande au statut 'Vérification métier', ce qui signifie que la saisie est consideree comme validee automatiquement.",
    "Le statut 'Paiement effectué' est un passage logique, mais l'etat final enregistre par le backend devient immediatement 'Clôturée'.",
    "La branche 'Rejetée' existe dans le code, meme si elle n'etait pas decrite dans la version metier initiale."
  ]
}
