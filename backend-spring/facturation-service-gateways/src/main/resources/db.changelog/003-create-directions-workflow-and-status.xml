<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-directions-workflow-and-status" author="copilot">
        <createTable tableName="directions">
            <column name="name" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="workflow_assignments">
            <column name="workflow_type" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="step" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_workflow_assignments_user"
                             referencedTableName="users" referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="position" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="status_catalog">
            <column name="workflow" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="varchar(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="position" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
